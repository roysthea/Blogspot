:root{
--bs-font-sans-serif:$(body.text.family);
--bs-body-bg:$(body.background);
--bs-body-color:$(body.text.color);
--rd-primary:$(keycolor);
--rd-heading-color:$(posts.title.color);
--rd-heading-link:$(posts.title.color);
--rd-heading-hover:$(keycolor);
--rd-link-color:$(body.link.color);
--rd-link-hover:$(body.hover.color);
--rd-blockquote:$(posts.text.color);
--rd-btn-primary:$(posts.icons.color);
--rd-btn-primary-hover:$(labels.background.color);
--rd-btn-light-hover:$(posts.title.color);
--rd-border-light:$(border.color);
--rd-bg-light:#f3f7f9;
--rd-archive-bg:#fff;
--rd-nav-color:$(tabs.color);
--rd-nav-hover:$(tabs.hover);
--rd-nav-selected:$(tabs.selected.color);
--rd-dropdown-bg:$(dropdown.bg);
--rd-dropdown-color:$(dropdown.color);
--rd-dropdown-hover:$(dropdown.hover);
--rd-dropdown-selected:$(dropdown.selected);

--rd-footer-bg:$(footer.bg);
--rd-footer-color:$(footer.color);
--rd-footer-link:$(footer.link);
--rd-footer-border:$(footer.border);
--rd-socket-bg:$(socket.bg);
--rd-socket-color:$(socket.color);
--rd-popup-bg:#fff
}
.dark-mode{
--bs-body-bg:hsl(210,11%,15%);
--bs-body-color:hsl(210,11%,80%);
--rd-heading-color:hsl(210,11%,80%);
--rd-heading-link:hsl(210,11%,80%);
--rd-btn-light-hover:hsl(210,11%,85%);
--rd-border-light:hsl(210,11%,20%);
--rd-bg-light:hsl(210,11%,20%);
--rd-archive-bg:hsl(210,11%,17%);
--rd-nav-color:hsl(210,11%,70%);
--rd-dropdown-bg:hsl(210,11%,18%);
--rd-dropdown-color:hsl(210,11%,70%);

--rd-footer-bg:hsl(210,11%,15%);
--rd-footer-color:hsl(210,11%,80%);
--rd-footer-border:hsl(210,11%,20%);
--rd-socket-bg:hsl(210,11%,17%);
--rd-socket-color:hsl(210,11%,80%);
--rd-popup-bg:hsl(210,11%,17%)
}